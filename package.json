{
  "name": "aas-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @aas-editor/web dev",
    "dev:server": "pnpm --filter @aas-editor/server dev",
    "test-data": "node scripts/fetch-test-data.mjs",
    "modell": "node scripts/make-large-model.mjs",
    "leistung": "pnpm --filter @aas-editor/web leistung",
    "budget": "node scripts/check-bundle-budget.mjs",
    "vorlagen": "node scripts/check-vorlagen.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ],
    "//overrides": "Behebt die transitiven Luecken aus `pnpm audit` (Sicherheitsaudit 11.08.2026). Jeweils die kleinste gepatchte Fassung im vorhandenen Major, damit nichts bricht.",
    "overrides": {
      "fast-uri": "^3.1.5",
      "nanoid": "^3.3.17",
      "js-yaml": "^4.3.1",
      "brace-expansion": "^5.0.9",
      "hono": "^4.12.34"
    }
  }
}
