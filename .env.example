# Woher die Identitaet kommt.
#
#   passwort  Ein Benutzer, Zugangsdaten aus dieser Datei, keine Benutzertabelle.
#             Bleibt die Rueckfallebene: geht am Hub etwas schief, ist der Editor
#             sonst fuer niemanden mehr erreichbar.
#   oidc      AXON Studio ist der Aussteller. Der Editor haelt weiterhin sein eigenes
#             Sitzungscookie; getauscht wird nur, woher die Identitaet kommt.
AUTH_MODE=passwort

# Nur bei AUTH_MODE=passwort noetig.
AUTH_USERNAME=alaettin
AUTH_PASSWORD=bitte-aendern

# Nur bei AUTH_MODE=oidc noetig, dann aber alle vier. Fehlt einer, bricht der Start ab
# und nicht erst der erste Anmeldeversuch.
#
# Die Redirect-URI muss die Adresse sein, die der **Browser** sieht, und sie muss exakt
# so am OAuth-Client in AXON Studio eingetragen sein. Platzhalter gibt es dort nicht.
# Entwicklung: http://localhost:5273/api/auth/callback (Vite reicht /api nach 3200 durch)
# Betrieb:     https://axon-editor.sliplane.app/api/auth/callback
#OIDC_ISSUER=https://<ref>.supabase.co/auth/v1
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=

SESSION_SECRET=langer-zufallswert
SESSION_TTL_HOURS=720

# Server
PORT=3200
NODE_ENV=development
# Traegt beides: DATA_DIR/aas-editor.db und DATA_DIR/attachments
DATA_DIR=./data
# Obergrenze je hochgeladenem Anhang
MAX_UPLOAD_MB=50

# Nur fuer den Docker-Betrieb: unter welcher Adresse Caddy lauscht. Leer lassen heisst
# nicht "Vorbelegung", sondern kaputtes Caddyfile, deshalb steht die Vorbelegung (:80) im
# Compose-File. Lokal mit HTTPS: "localhost".
AAS_EDITOR_DOMAIN=localhost

# Ein Hub-Konto fuer die Browserabnahme, nur bei AUTH_MODE=oidc noetig.
#HUB_TEST_EMAIL=
#HUB_TEST_PASSWORT=
