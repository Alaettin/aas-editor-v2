# Woher die Identitaet kommt.
#
#   passwort  Ein Benutzer, Zugangsdaten aus dieser Datei, keine Benutzertabelle.
#             Bleibt die Rueckfallebene: geht am Hub etwas schief, ist der Editor
#             sonst fuer niemanden mehr erreichbar.
#   oidc      AXON Studio ist der Aussteller. Der Editor haelt weiterhin sein eigenes
#             Sitzungscookie; getauscht wird nur, woher die Identitaet kommt.
AUTH_MODE=passwort

# Nur bei AUTH_MODE=passwort noetig.
AUTH_USERNAME=alaettin
AUTH_PASSWORD=bitte-aendern

# Nur bei AUTH_MODE=oidc noetig, dann aber alle vier. Fehlt einer, bricht der Start ab
# und nicht erst der erste Anmeldeversuch.
#
# Die Redirect-URI muss die Adresse sein, die der **Browser** sieht, und sie muss exakt
# so am OAuth-Client in AXON Studio eingetragen sein. Platzhalter gibt es dort nicht.
# Entwicklung: http://localhost:5273/api/auth/callback (Vite reicht /api nach 3200 durch)
# Betrieb:     https://axon-editor.sliplane.app/api/auth/callback
#OIDC_ISSUER=https://<ref>.supabase.co/auth/v1
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=

# Echter Zufall, nicht der Wortlaut hier. Aus ihm wird auch der Schluessel abgeleitet, mit
# dem der Assistenten-API-Schluessel verschluesselt liegt.
SESSION_SECRET=langer-zufallswert
# Wie lange die Editor-Sitzung gilt. 12 Stunden, damit ein Entzug am Hub am selben Tag greift
# (Sicherheitsaudit 11.08.2026). Frueher 720.
SESSION_TTL_HOURS=12

# Server
PORT=3200
NODE_ENV=development
# Traegt beides: DATA_DIR/aas-editor.db und DATA_DIR/attachments
DATA_DIR=./data
# Obergrenze je hochgeladenem Anhang
MAX_UPLOAD_MB=50

# --- Der MCP-Zugang -------------------------------------------------------------------
#
# Verlangt /api/mcp eine Anmeldung? "an" ist die Vorgabe und der Normalfall. "offen" ist
# der ausdrueckliche Verzicht fuer lokale Arbeit; der Server protokolliert dann beim Start
# eine Warnung und legt alles unter einem gemeinsamen Eigentuemer ab.
#MCP_AUTH=an
#
# Es gibt zwei Wege herein, und es muss mindestens einer offenstehen, sonst startet der
# Server nicht.
#
#   1. Ein fester Bearer-Token. Der Weg fuer Shell, Abnahme und Claude Code. Kein
#      Notnagel: der Hub bietet weder Dynamic Client Registration noch
#      Client-ID-Metadata-Dokumente an und nimmt keine portunabhaengige Rueckleitung auf
#      localhost, deshalb kann Claude Code den OAuth-Weg gar nicht gehen.
#      Mindestens 32 Zeichen, echter Zufall:  openssl rand -base64 48
#MCP_TOKEN=
#
#   2. OAuth ueber AXON Studio, fuer claude.ai. Braucht AUTH_MODE=oidc **und** diese
#      Liste: sie nennt die OAuth-Clients, deren Zugriffstoken angenommen werden.
#      Sie ist der eigentliche Zaun und nicht bloss Feinschliff. Bei Supabase steht in
#      `aud` immer "authenticated"; ohne die Bindung an `client_id` genuegte jedes
#      beliebige Sitzungstoken des Hubs, also auch eines aus einer ganz anderen
#      Anwendung, die denselben Hub benutzt.
#      Kommagetrennt. Die Kennung stammt aus dem Client, der im Hub fuer claude.ai
#      angelegt wurde (Umgebung "connector", Rueckweg
#      https://claude.ai/api/mcp/auth_callback).
#MCP_CLIENTS=

# Rechnernamen, die der MCP-Server abrufen darf, ohne dass seine Bereichspruefung mitredet.
# Kommagetrennt, genauer Name oder *.suffix. Der Ausweg fuer ein Herstellerportal, das der
# Zaun faelschlich fuer intern haelt. Freigestellt ist damit **nur** die Bereichspruefung:
# https, Groessengrenzen, Typenliste und die erneute Pruefung jedes Weiterleitungssprungs
# gelten weiter. Leer heisst: nichts freigestellt.
#MCP_NETZ_ERLAUBT=bdih-download.endress.com,*.beispiel-hersteller.de

# Die oeffentliche Adresse des Dienstes, fuer die Download-Links des MCP-Servers und die
# Basis-Adresse des Repositories. Ist sie gesetzt, wird sie statt des vom Klienten
# gemeldeten Host-Kopfs genommen (Sicherheitsaudit 11.08.2026, niedriger Befund). Leer:
# der Host aus der Anfrage, wie bisher.
#PUBLIC_BASE_URL=https://axon-editor.sliplane.app

# Nur fuer den Docker-Betrieb: unter welcher Adresse Caddy lauscht. Leer lassen heisst
# nicht "Vorbelegung", sondern kaputtes Caddyfile, deshalb steht die Vorbelegung (:80) im
# Compose-File. Lokal mit HTTPS: "localhost".
AAS_EDITOR_DOMAIN=localhost

# Ein Hub-Konto fuer die Browserabnahme, nur bei AUTH_MODE=oidc noetig.
#HUB_TEST_EMAIL=
#HUB_TEST_PASSWORT=
