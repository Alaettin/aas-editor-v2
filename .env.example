# Anmeldung, bewusst einfach: ein Benutzer, keine Benutzertabelle.
# Siehe Plan Abschnitt 9. Wird spaeter hinter dem AuthProvider ausgetauscht.
AUTH_USERNAME=alaettin
AUTH_PASSWORD=bitte-aendern
SESSION_SECRET=langer-zufallswert
SESSION_TTL_HOURS=720

# Server
PORT=3200
NODE_ENV=development
# Traegt beides: DATA_DIR/aas-editor.db und DATA_DIR/attachments
DATA_DIR=./data
# Obergrenze je hochgeladenem Anhang
MAX_UPLOAD_MB=50

# Nur fuer den Docker-Betrieb: unter welcher Adresse Caddy lauscht. Leer lassen heisst
# nicht "Vorbelegung", sondern kaputtes Caddyfile, deshalb steht die Vorbelegung (:80) im
# Compose-File. Lokal mit HTTPS: "localhost".
AAS_EDITOR_DOMAIN=localhost
